# Copia aquest fitxer a .env i omple'l. El .env NO s'ha de pujar mai a git (ja és al .gitignore).

# URL pública del teu addon, tal com la veurà el reproductor (https, sense barra final).
# Activa els streams de 3Cat en 1080p fix i en mode adaptatiu (endpoint /hls).
PUBLIC_BASE_URL=https://el-teu-domini.exemple

# Clau gratuïta de TMDB (https://www.themoviedb.org/settings/api). Necessària per al mapatge
# de temporades/episodis quan Cinemeta no té dades.
TMDB_API_KEY=

# Opcionals: si estan buides, aquestes fonts es desactiven soles.
ANIDD_PASSWORD=
RUNTIME_CS_AUTH=
